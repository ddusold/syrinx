{
  "name": "@syrinx/ui",
  "version": "0.0.0",
  "description": "The view contract, host bridges and view context for Syrinx views, plus shell rendering for servers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@syrinx/core": "workspace:^"
  },
  "devDependencies": {
    "@syrinx/mcp": "workspace:^",
    "happy-dom": "^21.0.3",
    "zod": "^4.6.7"
  }
}
