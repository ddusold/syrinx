  "properties": {
    "children": {
      "items": {
        "$ref": "#",
      },
      "type": "array",
    },
    "name": {
      "type": "string",
    },
  },
  "required": [
    "name",
    "children",
  ],
  "type": "object",
}
`;

exports[`toJsonSchema > keeps self-referencing definitions in $defs and inlines the rest 1`] = `
