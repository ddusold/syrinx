{
  "name": "@syrinx/example-invoices",
  "version": "0.0.0",
  "private": true,
  "description": "Example Syrinx apps: invoices and customers over REST and MCP, with permissions, confirmation, idempotent writes and Vue views.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "stdio": "tsx src/stdio.ts",
    "build:views": "tsx scripts/build-views.ts",
    "openapi": "tsx src/print-openapi.ts",
    "e2e:serve": "pnpm -s build:views && tsx e2e/serve.ts",
    "size:views": "tsx scripts/size-report.ts && rm -rf dist/size"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@syrinx/core": "workspace:*",
    "@syrinx/rest": "workspace:*",
    "zod": "^4.6.7",
    "@syrinx/mcp": "workspace:*",
    "@syrinx/ui": "workspace:*",
    "@syrinx/ui-vue": "workspace:*",
    "vue": "^3.5.44",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@syrinx/testing": "workspace:*",
    "tsx": "^4.23.15",
    "@syrinx/vite": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^7.3.7",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3"
  }
}
